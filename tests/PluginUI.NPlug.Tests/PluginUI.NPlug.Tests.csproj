<!-- 2026/10/19 13:37:00 UTC - PluginUI -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Hosts the plug-ins in-process (Steinberg validator): this assembly must not export a VST3 factory. -->
    <NPlugFactoryExport>false</NPlugFactoryExport>
    <!-- Logic, DSP and validator tests: no window needed, they also run on Linux CI. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!--
    Temporary: NPlug.Validator 1.4.0 was built before the ARM64 folder fix. On Windows ARM64 its managed side looks for
    the validator proxy in Contents\arm_64-win, while the native Steinberg validator loads Contents\arm64-win (where
    NPlug.Proxy 2.0.2 puts it): the proxy is copied to both. Remove with NPlug.Validator 1.4.1 (the version bump of
    xoofx/NPlug#27, not yet on NuGet).
  -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' and '$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">
    <Content Include="$(NPlugProxyLibraryFile)" Link="nplug_validator_proxy.vst3/Contents/arm_64-win/nplug_validator_proxy.vst3" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
    <!-- Official Steinberg VST3 validator (native), called in-process on the NPlug factory. -->
    <PackageReference Include="NPlug.Validator" Version="1.4.0.380" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PluginUI.NPlug\PluginUI.NPlug.csproj" />
    <ProjectReference Include="..\..\samples\PluginUI.DemoSynth\PluginUI.DemoSynth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
