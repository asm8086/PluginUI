<!-- 2026/10/24 18:46:00 UTC - PluginUI -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Hosts the plug-ins in-process (Steinberg validator): this assembly must not export a VST3 factory. -->
    <NPlugFactoryExport>false</NPlugFactoryExport>
    <!-- Logic, DSP and validator tests: no window needed, they also run on Linux CI. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- PerformEditTests builds a native IComponentHandler. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
    <!-- Official Steinberg VST3 validator (native), called in-process on the NPlug factory. -->
    <PackageReference Include="NPlug.Validator" Version="1.4.1.380" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PluginUI.NPlug\PluginUI.NPlug.csproj" />
    <ProjectReference Include="..\..\samples\PluginUI.DemoSynth\PluginUI.DemoSynth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
