<!-- 2026/10/18 14:24:00 UTC - PluginUI -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Documents, JSON, loader logic and code generation: no window needed, they also run on Linux CI. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0" />
    <!-- Compiles the generated .Designer.cs files to check them. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PluginUI.Design\PluginUI.Design.csproj" />
  </ItemGroup>

  <!-- The editor's document session and extension loader have no WinForms dependency: their sources are
       compiled here so the editing commands are tested on every platform. -->
  <ItemGroup>
    <Compile Include="..\..\tools\PluginUIEditor\DesignSession.cs" Link="Editor\DesignSession.cs" />
    <Compile Include="..\..\tools\PluginUIEditor\EditorStrings.cs" Link="Editor\EditorStrings.cs" />
    <Compile Include="..\..\tools\PluginUIEditor\Extensions.cs" Link="Editor\Extensions.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="PluginUI" />
    <Using Include="PluginUI.Design" />
  </ItemGroup>

</Project>
