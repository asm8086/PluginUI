<!-- 2026/11/08 17:00:00 UTC - PluginUI -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Hosts NPlug plug-ins in-process through their VST 3 factory: this assembly must not export one itself. -->
    <NPlugFactoryExport>false</NPlugFactoryExport>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fake VST 2 plug-in, hosted through its entry point (TestVst2 builds the same code as a native module). -->
    <Compile Include="..\PluginUI.Host.TestVst2\FakeVst2.cs" Link="FakeVst2.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gain32.dll: a real 32-bit VST 2 module (built from gain32.c) for the tests of the 32-bit bridge. -->
    <None Update="TestData\Gain32.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PluginUI.Host\PluginUI.Host.csproj" />
    <ProjectReference Include="..\..\src\PluginUI.Host.Vst2\PluginUI.Host.Vst2.csproj" />
    <ProjectReference Include="..\..\src\PluginUI.Host.Windows\PluginUI.Host.Windows.csproj" />
    <ProjectReference Include="..\..\samples\PluginUI.DemoSynth\PluginUI.DemoSynth.csproj" />
    <ProjectReference Include="..\PluginUI.Host.TestGain\PluginUI.Host.TestGain.csproj" />
    <ProjectReference Include="..\..\tools\PluginHost.Cli\PluginHost.Cli.csproj" />
  </ItemGroup>

</Project>
