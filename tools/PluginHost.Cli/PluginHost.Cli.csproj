<!-- 2026/11/08 17:00:00 UTC - PluginUI -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>pluginhost</AssemblyName>
    <RootNamespace>PluginUI.Host.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      No CET shadow stack (on by default since .NET 9): plug-ins are third-party native code, and some (copy protection,
      longjmp, coroutines) manipulate the stack in ways CET forbids; Windows then ends the process with 0xC0000409 in
      ntdll. DAWs do not enable CET either.
    -->
    <CETCompat>false</CETCompat>
    <!-- dotnet publish -c Release -r win-x64 -p:PublishAot=true : one self-contained pluginhost.exe. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PluginUI.Host\PluginUI.Host.csproj" />
    <ProjectReference Include="..\..\src\PluginUI.Host.Vst2\PluginUI.Host.Vst2.csproj" />
  </ItemGroup>

  <!-- The 32-bit bridge (PluginHost.Bridge32.exe) in the "bridge32" folder, for 32-bit VST 2 plug-ins. -->
  <Import Project="..\PluginHost.Bridge\Bridge32.targets" />

</Project>
