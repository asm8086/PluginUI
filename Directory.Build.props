<!-- 2026/10/19 07:48:00 UTC - PluginUI -->
<!-- SPDX-FileCopyrightText: 2026 asm8086 -->
<!-- SPDX-License-Identifier: MIT -->
<Project>

  <!--
    SIMD instruction set: see Directory.Build.targets (x86-64-v3 by default for NativeAOT x64 builds).
    No PlatformTarget here: libraries stay AnyCPU, so the same assemblies serve x64 and ARM64 (and NuGet consumers);
    executables and plug-ins get their architecture from their runtime identifier.
  -->
  <PropertyGroup>
    <!-- NativeAOT: favor speed over binary size (NPlug.targets already does it for plugins). -->
    <OptimizationPreference Condition="'$(OptimizationPreference)' == ''">Speed</OptimizationPreference>
  </PropertyGroup>

  <!--
    NPlug sources, shared by PluginUI.NPlug, the samples and the tests (a plug-in must reference the same NPlug.csproj).
    Default: the git submodule external/NPlug (xoofx/NPlug at tag 0.6.0; clone with recurse-submodules), else a sibling
    clone ..\NPlug, else the older sibling copy ..\NPlugCorrected. Override with -p:NPlugRoot=<folder>\src\.
    Sources rather than the NuGet package: NPlug.Proxy 2.0.1 (a dependency of NPlug 0.6.0 on NuGet) still writes the
    ARM64 plug-in to Contents\arm_64-win instead of Contents\arm64-win.
  -->
  <PropertyGroup>
    <NPlugRoot Condition="'$(NPlugRoot)' == '' and Exists('$(MSBuildThisFileDirectory)external/NPlug/src/NPlug/NPlug.csproj')">$(MSBuildThisFileDirectory)external\NPlug\src\</NPlugRoot>
    <NPlugRoot Condition="'$(NPlugRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../NPlug/src/NPlug/NPlug.csproj')">$(MSBuildThisFileDirectory)..\NPlug\src\</NPlugRoot>
    <NPlugRoot Condition="'$(NPlugRoot)' == ''">$(MSBuildThisFileDirectory)..\NPlugCorrected\src\</NPlugRoot>
  </PropertyGroup>

  <!-- Version, authorship and package metadata (only PluginUI and PluginUI.Design are packed). -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>asm8086</Authors>
    <Company>asm8086</Company>
    <Product>PluginUI</Product>
    <Copyright>Copyright (c) 2026 asm8086</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://asm8086.github.io/PluginUI/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/asm8086/PluginUI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>audio;vst3;plugin;ui;gui;direct2d;win32;nativeaot;nplug</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <IsPackable>false</IsPackable>
    <!-- Source Link (built into the SDK), symbol packages, reproducible builds on CI. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)docs\images\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Culture-independent code: CA1304 / CA1305 are errors (see CodeAnalysis.globalconfig). Tests are exempt. -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true' and '$(MSBuildProjectExtension)' == '.csproj'">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)CodeAnalysis.globalconfig" />
  </ItemGroup>

</Project>
