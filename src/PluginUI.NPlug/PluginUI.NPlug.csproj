<!-- 2026/10/19 07:48:00 UTC - PluginUI -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>PluginUI.NPlug</RootNamespace>
    <AssemblyName>PluginUI.NPlug</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Not packed yet: it references the NPlug sources (NPlug.Proxy 2.0.1 on NuGet lacks the arm64-win folder fix). -->
    <IsPackable>false</IsPackable>
    <Description>Hosts PluginUI editors in NPlug (VST3) plug-ins: IAudioPluginView adapter and parameter binding.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- NPlugRoot (NPlug sources) is set in ../../Directory.Build.props. -->
  <ItemGroup>
    <ProjectReference Include="..\PluginUI\PluginUI.csproj" />
    <ProjectReference Include="$(NPlugRoot)NPlug\NPlug.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PluginUI.NPlug.Tests" />
  </ItemGroup>

</Project>
