<!-- 2026/10/18 17:31:00 UTC - PluginUI -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>PluginUI.NPlug</RootNamespace>
    <AssemblyName>PluginUI.NPlug</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Not packed until the NPlug fixes it needs are released upstream: it references the patched NPlug sources. -->
    <IsPackable>false</IsPackable>
    <Description>Hosts PluginUI editors in NPlug (VST3) plug-ins: IAudioPluginView adapter and parameter binding.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- NPlugRoot (patched NPlug sources) is set in ../../Directory.Build.props. -->
  <ItemGroup>
    <ProjectReference Include="..\PluginUI\PluginUI.csproj" />
    <ProjectReference Include="$(NPlugRoot)NPlug\NPlug.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PluginUI.NPlug.Tests" />
  </ItemGroup>

</Project>
