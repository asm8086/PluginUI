<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the official Steinberg VST3 validator on a built plug-in (.vst3 file or bundle folder): release checks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- A host, not a plug-in: no VST3 factory export. -->
    <NPlugFactoryExport>false</NPlugFactoryExport>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NPlug.Validator" Version="1.4.0.380" />
  </ItemGroup>

</Project>
