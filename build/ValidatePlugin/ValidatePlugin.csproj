<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the official Steinberg VST3 validator on a built plug-in (.vst3 file or bundle folder): release checks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- A host, not a plug-in: no VST3 factory export. -->
    <NPlugFactoryExport>false</NPlugFactoryExport>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Temporary: NPlug.Validator 1.4.0 was built before the ARM64 folder fix. On Windows ARM64 its type initializer looks
    for the validator proxy in Contents\arm_64-win, while NPlug.Proxy 2.0.2 puts it in arm64-win: a copy lets the
    validator start (this tool validates plug-in files, which does not use the proxy). Remove with NPlug.Validator
    1.4.1 (the version bump of xoofx/NPlug#27, not yet on NuGet).
  -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' and '$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">
    <Content Include="$(NPlugProxyLibraryFile)" Link="nplug_validator_proxy.vst3/Contents/arm_64-win/nplug_validator_proxy.vst3" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NPlug.Validator" Version="1.4.0.380" />
  </ItemGroup>

</Project>
