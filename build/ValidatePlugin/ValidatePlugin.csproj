<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the official Steinberg VST3 validator on a built plug-in (.vst3 file or bundle folder): release checks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- A host, not a plug-in: no VST3 factory export. -->
    <NPlugFactoryExport>false</NPlugFactoryExport>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Temporary: NPlug.Validator 1.4.0 was built before the ARM64 folder fix and looks for its proxy in
    Contents\arm_64-win on Windows ARM64, while NPlug.Proxy 2.0.2 names the folder arm64-win. Remove with
    NPlug.Validator 1.4.1 (the version bump of xoofx/NPlug#27, not yet on NuGet).
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and '$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">
    <NPlugVstArch>arm_64-win</NPlugVstArch>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NPlug.Validator" Version="1.4.0.380" />
  </ItemGroup>

</Project>
