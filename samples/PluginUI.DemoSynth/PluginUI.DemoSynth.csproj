<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>PluginUI.DemoSynth</RootNamespace>
    <AssemblyName>PluginUI.DemoSynth</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Debug (non-AOT) mode: the NPlug proxy (PluginUI.DemoSynth.vst3) loads this assembly with CoreCLR, so the
         dependency assemblies must sit next to it. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>

    <!-- Windows plug-in for the architecture of the build machine by default (bin\$(Configuration)\net10.0\win-x64\ on x64);
         -r win-x64 / win-arm64 to choose.
         The NativeAOT instruction set comes from ..\..\Directory.Build.targets. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
  </PropertyGroup>

  <!--
    "dotnet publish" builds the NativeAOT .vst3; "dotnet build" keeps the CoreCLR debug proxy. Set here because NPlug.targets,
    imported from the NuGet package, comes too late to enable PublishAot. Projects referencing the PluginUI.NPlug package get
    this from the package.
  -->
  <PropertyGroup>
    <PublishAot Condition="'$(PublishAot)' == '' and '$(_IsPublishing)' == 'true'">true</PublishAot>
  </PropertyGroup>

  <!--
    PluginUI.NPlug brings the NPlug package and its build files: native debug proxy (Debug), native export of
    GetPluginFactory, NativeAOT defaults, .vst3 output. A plug-in using the NuGet packages references PluginUI.NPlug the
    same way (<PackageReference Include="PluginUI.NPlug" ... />).
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\PluginUI.NPlug\PluginUI.NPlug.csproj" />
  </ItemGroup>

</Project>
