<!-- 2026/10/18 16:20:00 UTC - PluginUI -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>PluginUI.Gallery</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Also publishable with NativeAOT: dotnet publish -c Release -p:PublishAot=true -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Windows application for the architecture of the build machine by default (-r win-x64 / win-arm64 to choose);
         NativeAOT instruction set: ..\..\Directory.Build.targets. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PluginUI\PluginUI.csproj" />
  </ItemGroup>

</Project>
